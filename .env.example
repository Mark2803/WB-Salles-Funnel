# Скопируйте этот файл в .env и заполните. Файл .env в git НЕ коммитить.

# Адрес и порт, на котором приложение слушает (снаружи — через nginx)
HOST=127.0.0.1
PORT=3300

# Путь, по которому nginx отдаёт приложение (используется для cookie)
BASE_PATH=/management/wb-funnel

# Токен WB API: персональный, «Только чтение».
# Категории: Аналитика, Цены и скидки, Продвижение, Вопросы и отзывы, Финансы.
WB_API_TOKEN=

# Вход — через админку → «Менеджмент» (PIN), отдельного пароля нет.
# База сайта Чайного Маркета: тот же DATABASE_URL, что в /home/ivanc1539/tea-market-v2/backend/.env
# (по ней проверяется пропуск после ввода PIN; инструмент только читает таблицу management_access_tokens)
DATABASE_URL=

# Случайная строка не короче 32 символов (подпись cookie). Создать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Где хранить базу данных SQLite
DATA_DIR=./data

# Какие товары отслеживать — галочки «Воронка WB» в Менеджменте → «Товары и остатки»
# (колонка «Воронка WB» в листе «Себестоимость»). Этот список — запасной: пока колонки нет.
TRACKED_NM_IDS=1293796729,1293810594,1293819178,1293824574,1293830368,1293530574,1293550875,1293557865,1293561361,1293566093

# Как часто обновлять воронку, рекламу и цены (часы). Отзывы и финотчёт — раз в сутки.
SYNC_EVERY_HOURS=3

# Себестоимость: Google Таблица «Финансы V3», лист «Себестоимость» (тот же, что в Менеджменте).
# Ключ робота Google — тот же файл, что у Менеджмента. Id таблицы — как SPREADSHEET_ID в /home/ivanc1539/managment/backend/.env
# (репозиторий публичный — id сюда не вписывать, только в .env на сервере)
GOOGLE_SERVICE_ACCOUNT_FILE=/home/ivanc1539/managment-secrets/google-key.json
COSTS_SPREADSHEET_ID=
COSTS_SHEET=Себестоимость

# 1 — тестовые данные вместо WB API (для проверки без токена)
WB_MOCK=0

# 1 — cookie только по https (на сервере оставить 1)
COOKIE_SECURE=1
